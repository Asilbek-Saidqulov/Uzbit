# Judge0 proxy for C++ and Rust. Keep this as /api/judge0 and set the RapidAPI key
# on the server (Vercel project settings): JUDGE0_RAPIDAPI_KEY and JUDGE0_RAPIDAPI_HOST.
VITE_JUDGE0_URL=/api/judge0

# Accounts and database (Supabase). Leave empty to run in the browser only.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
